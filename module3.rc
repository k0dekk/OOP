#include "resource.h"

#define APSTUDIO_HIDDEN_SYMBOLS
#include "windows.h"
#undef APSTUDIO_HIDDEN_SYMBOLS

#pragma code_page(65001)
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_DIALOG_MOD3 DIALOGEX 0, 0, 220, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Робота2: крок 2 з 2"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Друге вікно діалогу.",IDC_STATIC,14,14,192,8
    LTEXT           "[< Назад] повертає до першого вікна, [Так] підтверджує вибір.",IDC_STATIC,14,28,192,16
    PUSHBUTTON      "< Назад",IDC_BACK_MOD3,30,56,50,14
    DEFPUSHBUTTON   "Так",IDOK,86,56,50,14
    PUSHBUTTON      "Відміна",IDCANCEL,142,56,50,14
END
