#include "resource.h"

#define APSTUDIO_HIDDEN_SYMBOLS
#include "windows.h"
#undef APSTUDIO_HIDDEN_SYMBOLS

#pragma code_page(65001)
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_DIALOG_MOD1 DIALOGEX 0, 0, 220, 92
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Робота1: вибір числа"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Рухайте повзунок, щоб вибрати число від 1 до 100:",IDC_STATIC,12,10,196,8
    CTEXT           "50",IDC_VALUE_MOD1,12,26,196,10
    CONTROL         "",IDC_SCROLLBAR_MOD1,"ScrollBar",SBS_HORZ | WS_TABSTOP,12,42,196,11
    DEFPUSHBUTTON   "Так",IDOK,52,68,50,14
    PUSHBUTTON      "Відміна",IDCANCEL,118,68,50,14
END
